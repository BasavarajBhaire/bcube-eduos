{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcubefutureacademy.in/schemas/bcube-page-runtime-contract-v2.schema.json",
  "title": "BCube Page Runtime Contract V2",
  "type": "object",
  "required": ["identity", "learning", "activity", "illustration", "layout", "guidance", "validation"],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": ["page_id", "book_slug", "level", "title", "physical_page", "printed_page", "page_type"],
      "additionalProperties": false,
      "properties": {
        "page_id": {"type": "string", "pattern": "^[A-Z]{2}-[A-Z]+-V[0-9]+-P[0-9]{3}$"},
        "book_slug": {"type": "string", "minLength": 1},
        "level": {"enum": ["nursery", "lkg", "ukg"]},
        "title": {"type": "string", "minLength": 1},
        "physical_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": ["integer", "null"], "minimum": 1},
        "page_type": {"type": "string", "minLength": 1}
      }
    },
    "learning": {
      "type": "object",
      "required": ["objective", "instruction"],
      "additionalProperties": false,
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "expected_response": {"type": "string"},
        "model_text": {"type": ["string", "null"]}
      }
    },
    "activity": {
      "type": "object",
      "required": ["archetype", "mechanic", "render_kind", "response_mode", "mechanics"],
      "additionalProperties": false,
      "properties": {
        "archetype": {"type": "string", "minLength": 1},
        "mechanic": {"type": "string", "minLength": 1},
        "render_kind": {"type": "string", "minLength": 1},
        "response_mode": {"type": "string", "minLength": 1},
        "mechanics": {"type": "object"}
      }
    },
    "illustration": {
      "type": "object",
      "required": ["source_asset", "assets", "asset_crops", "crop_safe", "must_match_prompt"],
      "additionalProperties": false,
      "properties": {
        "source_asset": {"type": "string", "minLength": 1},
        "assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "asset_crops": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false,
            "properties": {
              "x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1},
              "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "padding": {"type": "number", "minimum": 0, "maximum": 0.1}
            }
          }
        },
        "crop_safe": {"const": true},
        "must_match_prompt": {"const": true}
      }
    },
    "layout": {
      "type": "object",
      "required": ["template", "parent_panel", "home_connection", "generic_response_panel"],
      "additionalProperties": false,
      "properties": {
        "template": {"type": "string", "minLength": 1},
        "parent_panel": {"const": false},
        "home_connection": {"const": false},
        "generic_response_panel": {"const": false},
        "zones": {"type": "object"}
      }
    },
    "guidance": {
      "type": "object",
      "required": ["teacher_cue"],
      "additionalProperties": false,
      "properties": {
        "teacher_cue": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "allow_fallback", "illustration_contract_aligned"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["READY", "BLOCKED"]},
        "allow_fallback": {"const": false},
        "illustration_contract_aligned": {"type": "boolean"},
        "blocked_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
