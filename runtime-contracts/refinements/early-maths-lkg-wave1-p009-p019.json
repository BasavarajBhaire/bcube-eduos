      "mechanics": {"rows": [
        {"asset":"row_1","tokens":[3,1,2],"answer":[1,2,3],"slot_count":3},
        {"asset":"row_2","tokens":[8,6,7,5],"answer":[5,6,7,8],"slot_count":4},
        {"asset":"row_3","tokens":[14,11,13,12],"answer":[11,12,13,14],"slot_count":4}
