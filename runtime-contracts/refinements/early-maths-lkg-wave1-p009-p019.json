      "mechanics": {"rows": [
        {"asset":"sequence_1","sequence":[1,2,null,4,5],"blank_count":1,"answer":3},
        {"asset":"sequence_2","sequence":[6,null,8,9,10],"blank_count":1,"answer":7},
        {"asset":"sequence_3","sequence":[11,12,13,null,15],"blank_count":1,"answer":14}
