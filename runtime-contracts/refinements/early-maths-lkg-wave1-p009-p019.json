        {"asset":"star_group","quantity":2,"choices":[1,2,3]},
        {"asset":"balloon_group","quantity":3,"choices":[2,3,4]},
        {"asset":"fish_group","quantity":4,"choices":[3,4,5]},
        {"asset":"flower_group","quantity":5,"choices":[4,5,6]},
        {"asset":"leaf_group","quantity":6,"choices":[5,6,7]}
