    "EM-LKG-V4-P012": {
      "render_kind": "comparison-pairs",
      "layout": "comparison-three-pairs-v2",
      "instruction": "For each row, follow the prompt and circle the correct group.",
      "teacher_cue": "Compare first, then count both groups to check.",
      "mechanics": {"pairs": [
        {"left":"pair_1_left","right":"pair_1_right","prompt":"Circle more.","answer":"right"},
        {"left":"pair_2_left","right":"pair_2_right","prompt":"Circle less.","answer":"right"},
        {"left":"pair_3_left","right":"pair_3_right","prompt":"Circle more.","answer":"right"}
      ]}
    },
    "EM-LKG-V4-P013": {
      "render_kind": "comparison-pairs",
      "layout": "equal-groups-three-pairs-v2",
      "instruction": "Count both groups. Circle YES when they are equal and NO when they are not.",
      "teacher_cue": "Count the first group, then check whether the partner has the same number.",
      "mechanics": {"pairs": [
        {"left":"pair_1_left","right":"pair_1_right","choices":["YES","NO"],"answer":"YES"},
        {"left":"pair_2_left","right":"pair_2_right","choices":["YES","NO"],"answer":"NO"},
        {"left":"pair_3_left","right":"pair_3_right","choices":["YES","NO"],"answer":"YES"}
      ]}
