        {"asset":"line_1","range":[0,5],"start":0,"jumps":2,"landing":2,"choices":[1,2,3]},
        {"asset":"line_2","range":[5,10],"start":5,"jumps":3,"landing":8,"choices":[7,8,9]},
        {"asset":"line_3","range":[10,15],"start":10,"jumps":4,"landing":14,"choices":[13,14,15]}
